{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/tiket/(.*)",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|tiket/|sitemap\\.xml|robots\\.txt|assets/|src/|uploads/).*)",
      "destination": "/index.html"
    }
  ]
}
