# GEMINI_API_KEY: Optional for AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL of the application
APP_URL="http://localhost:3000"

# MIDTRANS CONFIGURATION (Sandbox by default)
# Server Key NEVER exposed to client. Keep safe.
MIDTRANS_SERVER_KEY="SB-Mid-server-YOUR_SANDBOX_SERVER_KEY"
MIDTRANS_CLIENT_KEY="SB-Mid-client-YOUR_SANDBOX_CLIENT_KEY"
MIDTRANS_IS_PRODUCTION="false"

# SUPABASE POSTGRESQL & AUTH
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# TRANSACTIONAL EMAIL (Resend or SMTP simulator)
RESEND_API_KEY="re_sample_key_for_production"
ADMIN_SESSION_SECRET="super-secure-admin-secret-token-change-in-production"
